# ─────────────────────────────────────────────────────
# StormSight PS77 — root .gitignore
# ─────────────────────────────────────────────────────

# ── OS ────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Python ────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.venv/
venv/
env/
.env
.env.prod
.env.local
pip-log.txt
pip-delete-this-directory.txt

# ── Pytest / coverage ─────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
nosetests.xml
coverage.xml

# ── Jupyter ───────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Node / Frontend ───────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp/
.pnp.js
.yarn/cache
.yarn/unplugged
.next/
out/
.nuxt/
dist/

# ── IDEs ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ── Data — raw downloads (large, not for version control) ──
data/raw/
data/interim/

# ── ML model checkpoints ──────────────────────────────
ml/checkpoints/*.pt
ml/checkpoints/*.pth
ml/checkpoints/*.ckpt
!ml/checkpoints/.gitkeep

# ── Satellite / geospatial files ──────────────────────
*.tif
*.tiff
*.nc
*.npy
*.hdf5
*.h5
*.grib
*.grib2

# ── Logs and reports ──────────────────────────────────
*.log
reports/
logs/

# ── Secrets ───────────────────────────────────────────
*.pem
*.key
secrets/
credentials.json

# ── Docker ────────────────────────────────────────────
.docker/

# ── Alembic auto-generated ────────────────────────────
alembic/__pycache__/
